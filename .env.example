# -----------------------------------------------------------------------------
# OpenDSS Cloud - configuración local. Los secretos NO viven en este archivo.
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
RECYCLE_THRESHOLD=162
MAX_ACTIVE_SIMULATIONS=32
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=500
ALLOW_CUSTOM_MODELS=true
CUSTOM_MODELS_DIR=data/runtime/custom_models
CORS_ORIGINS=

# Ejecución local multi-worker
EXECUTION_BACKEND=worker_pool
WORKER_DISCOVERY_BACKEND=static
SIMULATION_WORKER_URLS=http://simulation-worker-1:8100,http://simulation-worker-2:8100,http://simulation-worker-3:8100
SIMULATION_WORKER_URL=http://simulation-worker-1:8100
SIMULATION_WORKER_TIMEOUT_SECONDS=600

# Discovery AWS. CloudFormation sobrescribe estos valores en ECS.
WORKER_DISCOVERY_HOST=simulation-worker.opendss.local
WORKER_DISCOVERY_PORT=8100
WORKER_DISCOVERY_SCHEME=http
WORKER_DISCOVERY_REFRESH_SECONDS=5

# Auth / seguridad
JWT_EXPIRE_MINUTES=30
JWT_ISSUER=opendss-cloud
JWT_AUDIENCE=opendss-api
AUTH_ENABLED=true
SECURITY_EVENT_BUFFER_SIZE=1000
MAX_CONCURRENT_SIMULATIONS_PER_USER=2
MAX_CONCURRENT_JOBS=8
ADMISSION_CONTROL_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
WORKER_MAX_RETRIES=2
WORKER_RETRY_BACKOFF_SECONDS=2
WORKER_RETRY_ENABLED=true
WORKER_TEST_PROGRESS_DELAY_MS=0

# Secretos locales se montan como Docker secrets o se leen con *_FILE:
# JWT_SECRET_FILE=/run/secrets/jwt-secret
# AUTH_USERS_JSON_FILE=/run/secrets/auth-users
# WORKER_SHARED_TOKEN_FILE=/run/secrets/worker-token
